---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import fs from 'node:fs';
import yaml from 'js-yaml';

const aboutMeRaw = fs.readFileSync('./src/content/aboutMe.yaml', 'utf8');
const aboutMeContent = yaml.load(aboutMeRaw) as { sections: { title: string, content: string }[] };
---

<SiteLayout title={SITE_TITLE + ' | About Me'} description={SITE_DESCRIPTION}>
  <h1>About Me</h1>
  <hr />
  {aboutMeContent.sections.map(section => (
    <section>
      <h2>{section.title}</h2>
      <div class="about-content" set:html={section.content} />
    </section>
  ))}
</SiteLayout>

<style>
  section {
    margin-bottom: 2rem;
  }
</style>
