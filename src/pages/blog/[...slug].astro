---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getBlogPostsWithTaxonomy, getBlogStaticPaths } from '../../lib/content';

export async function getStaticPaths() {
  return getBlogStaticPaths();
}

const post = Astro.props as CollectionEntry<'blog'>;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
const taxonomy = (await getBlogPostsWithTaxonomy()).find(({ post: entry }) => entry.id === post.id);
const tags = taxonomy?.tags.map((tag) => ({ label: tag.label, slug: tag.slug })) ?? [];
const category = taxonomy?.category;
---

<BlogPost title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} tags={tags} category={category}>
  <Content />
</BlogPost>
