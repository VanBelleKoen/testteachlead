---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getBlogHeroImage } from '../../utils/getBlogHeroImage';
import { getBlogPostsWithTaxonomy, getBlogTagSummaries, getBlogCategorySummaries } from '../../lib/content';

const posts = await getBlogPostsWithTaxonomy();
const tags = await getBlogTagSummaries();
const categories = await getBlogCategorySummaries();
const featuredTags = tags.slice(0, 10);
---

<SiteLayout title={SITE_TITLE + " | Blog"} description={SITE_DESCRIPTION}>
  <div class="blog-container">
    <header class="page-header surface-elevated animate-rise-in">
      <div class="section-kicker">Editorial Stream</div>
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">Thoughts, guides, and tutorials on test automation, development, and team leadership.</p>
    </header>

    <div class="taxonomy-nav">
      <a href="/blog/categories" class="taxonomy-link">Categories ({categories.length})</a>
      <a href="/blog/tags" class="taxonomy-link">Tags ({tags.length})</a>
    </div>

    <div class="tag-cloud">
      {featuredTags.map((tag) => (
        <a href={`/blog/tags/${tag.slug}/`} class="tag-pill">{tag.label}</a>
      ))}
    </div>

    <div class="blog-grid">
      {posts.map(({ post, tags: postTags, category }) => {
        const { src, visual } = getBlogHeroImage(post.data.heroImage, post.data.title);
        return (
          <article class="blog-card motion-lift">
            <a href={`/blog/${post.id}/`} class="card-image-link">
              <div class="image-wrapper">
                {visual
                  ? (<img src={src} alt={post.data.title} class="post-image" loading="lazy" />)
                  : (<Image width={320} height={160} src={src} alt={post.data.title} class="post-image" loading="lazy" />)
                }
              </div>
            </a>
            
            <div class="card-content">
              <div class="post-meta">
                <span class="post-date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </div>
              <div class="post-taxonomy-row">
                <a href={`/blog/categories/${category.slug}/`} class="category-chip">{category.label}</a>
                <div class="post-tags">
                  {postTags.slice(0, 3).map((tag) => (
                    <a href={`/blog/tags/${tag.slug}/`} class="tag-chip">{tag.label}</a>
                  ))}
                </div>
              </div>
              <h3 class="post-title">
                <a href={`/blog/${post.id}/`} class="title-link">
                  {post.data.title}
                </a>
              </h3>
              {post.data.description && (
                <p class="post-excerpt">{post.data.description}</p>
              )}
            </div>
            
            <div class="card-footer">
              <a href={`/blog/${post.id}/`} class="read-more-link">
                Read post <span class="arrow">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</SiteLayout>

<style>
  .blog-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    position: relative;
    overflow: hidden;
    text-align: center;
    margin-bottom: 2.2rem;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2.2rem 1.4rem 1.8rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }

  .section-kicker {
    margin: 0 0 0.6rem 0;
    font-size: 0.74rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent-blog);
    font-family: var(--font-mono);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    margin: 0 0 0.4rem 0;
  }

  .page-subtitle {
    font-size: 1.02rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .taxonomy-nav {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.95rem;
    flex-wrap: wrap;
  }

  .taxonomy-link {
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.85rem;
    background: rgba(6, 10, 18, 0.56);
  }

  .taxonomy-link:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin: 0 0 2.1rem 0;
  }

  .tag-pill {
    font-size: 0.78rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-secondary);
    padding: 0.15rem 0.6rem;
  }

  .tag-pill:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  /* Grid Layout */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.6rem;
  }

  .blog-card {
    background: linear-gradient(160deg, rgba(34, 211, 238, 0.08), rgba(34, 211, 238, 0.01)), var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth), transform var(--transition-fast);
  }

  .blog-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }

  .card-image-link {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .image-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--transition-smooth);
    border: none;
    border-radius: 0;
  }

  .blog-card:hover .post-image {
    opacity: 0.9;
  }

  .card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .post-taxonomy-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
    align-items: center;
  }

  .category-chip,
  .tag-chip {
    font-size: 0.72rem;
    border-radius: 999px;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  .category-chip {
    border-color: rgba(34, 211, 238, 0.45);
    color: var(--accent-blog);
    background: rgba(34, 211, 238, 0.1);
  }

  .tag-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .post-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.75rem 0;
  }

  .title-link {
    color: var(--text-primary);
    transition: color var(--transition-smooth);
  }

  .title-link:hover {
    color: var(--accent-primary);
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border-color);
    margin-top: auto;
  }

  .read-more-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color var(--transition-smooth);
  }

  .blog-card:hover .read-more-link {
    color: var(--accent-primary);
  }

  .arrow {
    transition: transform var(--transition-smooth);
  }

  .blog-card:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
