---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HomeContent from '../content/home.md';
import FormattedDate from '../components/FormattedDate.astro';
import { getFeaturedProjects, getRecentBlogPosts, getBlogPostsSorted, getProjectCards } from '../lib/content';

// Fetch recent blog posts
const posts = await getRecentBlogPosts(3);
const totalPosts = (await getBlogPostsSorted()).length;
const totalProjects = (await getProjectCards()).length;

// Fetch featured projects
const projects = await getFeaturedProjects(3);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero-shell surface-elevated animate-rise-in">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-tag">Quality Engineering &bull; Mentorship &bull; Leadership</div>
    <h1 class="hero-title">Test. Teach. Lead.</h1>
    <p class="hero-subtitle">
      Practical quality strategy for teams shipping real software: resilient automation, meaningful coverage, and leadership that scales.
    </p>
    <div class="hero-actions">
      <a href="/projects" class="btn btn-primary">Explore Projects</a>
      <a href="/blog" class="btn btn-secondary">Read the Blog</a>
    </div>
    <div class="hero-meta-line" aria-label="Site highlights">
      <span>{totalPosts}+ articles</span>
      <span class="meta-divider" aria-hidden="true">•</span>
      <span>{totalProjects}+ projects</span>
      <span class="meta-divider" aria-hidden="true">•</span>
      <a href="/speaking" class="micro-link">upcoming talks</a>
      <span class="meta-divider" aria-hidden="true">•</span>
      <a href="/about" class="micro-link">about me</a>
    </div>
  </section>

  <hr class="section-divider" />

  <div class="home-grid">
    <div class="main-content-column">
      <div class="prose-card surface-elevated motion-lift animate-rise-in" style="animation-delay: 90ms;">
        <HomeContent />
      </div>
    </div>
    
    <div class="side-content-column">
      <div class="section-panel writing-panel motion-lift animate-rise-in" style="animation-delay: 140ms;">
        <h3 class="panel-title">Recent Writing</h3>
        <ul class="recent-list">
          {posts.map(post => (
            <li class="recent-item">
              <span class="item-date">
                <FormattedDate date={post.data.pubDate} />
              </span>
              <a href={`/blog/${post.id}/`} class="item-link">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
        <a href="/blog" class="panel-more-link">View all posts &rarr;</a>
      </div>

      <div class="section-panel projects-panel motion-lift animate-rise-in" style="animation-delay: 180ms;">
        <h3 class="panel-title">Featured Projects</h3>
        <ul class="recent-list">
          {projects.map(project => (
            <li class="recent-item">
              <a href={`/projects/${project.slug}`} class="item-link project-title-link">
                {project.title.split(' (')[0]}
              </a>
              <p class="item-desc">{project.description.slice(0, 90)}...</p>
            </li>
          ))}
        </ul>
        <a href="/projects" class="panel-more-link">View all projects &rarr;</a>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .hero-shell {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 3rem 1.8rem 2.2rem 1.8rem;
    max-width: 860px;
    margin: 0 auto;
    border-radius: 18px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }

  .hero-glow {
    position: absolute;
    top: -130px;
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    height: 280px;
    pointer-events: none;
    background: radial-gradient(circle at center, rgba(34, 211, 238, 0.15), rgba(14, 165, 233, 0));
  }

  .hero-tag {
    position: relative;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-tertiary);
    margin-bottom: 1rem;
  }

  .hero-title {
    position: relative;
    font-size: clamp(2.6rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 1.1rem;
    line-height: 1.1;
  }

  .hero-subtitle {
    position: relative;
    font-size: 1.06rem;
    color: var(--text-secondary);
    max-width: 630px;
    margin: 0 auto 2.05rem auto;
    line-height: 1.62;
  }

  .hero-actions {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .hero-meta-line {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0.2rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .micro-link {
    font-size: 0.84rem;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(166, 183, 214, 0.2);
    padding-bottom: 0.1rem;
    text-transform: lowercase;
  }

  .micro-link:hover {
    color: var(--text-primary);
    border-bottom-color: rgba(245, 248, 255, 0.35);
  }

  .meta-divider {
    color: rgba(124, 145, 181, 0.8);
    line-height: 1;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.68rem 1.25rem;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 8px;
    transition: background-color var(--transition-smooth), color var(--transition-smooth), border-color var(--transition-smooth), transform var(--transition-fast);
    border: 1px solid transparent;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: #031522;
  }

  .btn-primary:hover {
    color: #031522;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(7, 12, 20, 0.35);
    border-color: var(--border-color);
    color: var(--text-secondary);
  }

  .btn-secondary:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .section-divider {
    margin: 3.2rem 0 2.2rem 0;
  }

  /* Homepage Layout Grid */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 2.15rem;
  }

  .prose-card {
    background: linear-gradient(145deg, rgba(16, 185, 129, 0.045), rgba(16, 185, 129, 0.01)), var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2.5rem;
    height: 100%;
    box-shadow: var(--shadow-sm);
  }

  .prose-card :global(h2) {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 1rem;
    border: none;
    padding: 0;
  }

  .prose-card :global(p) {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .prose-card :global(p:last-of-type) {
    margin-bottom: 0;
  }

  /* Side Panel */
  .side-content-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-panel {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .writing-panel {
    background: linear-gradient(160deg, rgba(34, 211, 238, 0.08), rgba(34, 211, 238, 0.01)), var(--bg-secondary);
  }

  .projects-panel {
    background: linear-gradient(160deg, rgba(16, 185, 129, 0.07), rgba(16, 185, 129, 0.01)), var(--bg-secondary);
  }

  .panel-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.15rem;
    margin-top: 0;
    margin-bottom: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .writing-panel .panel-title::before,
  .projects-panel .panel-title::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .writing-panel .panel-title::before {
    background: var(--accent-blog);
  }

  .projects-panel .panel-title::before {
    background: var(--accent-projects);
  }

  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .recent-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .item-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .item-link {
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    transition: color var(--transition-smooth), transform var(--transition-fast);
  }

  .item-link:hover {
    color: var(--accent-primary);
    transform: none;
  }

  .project-title-link {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .item-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .panel-more-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-primary);
    transition: color var(--transition-smooth);
  }

  .panel-more-link:hover {
    color: var(--accent-secondary);
  }

  /* Responsive styling */
  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-shell {
      padding: 2.6rem 1.3rem 2rem 1.3rem;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      max-width: 280px;
      margin: 0 auto;
    }

    .hero-meta-line {
      justify-content: flex-start;
      gap: 0.4rem;
    }
    
    .prose-card {
      padding: 1.5rem;
    }
  }
</style>
