---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { type CollectionEntry, render } from 'astro:content';
import { getProjectStaticPaths } from '../../lib/content';

export async function getStaticPaths() {
  return getProjectStaticPaths();
}

const project = Astro.props as CollectionEntry<'projects'>;
const { Content } = await render(project);
const { title, description } = project.data;
---
<SiteLayout title={title} description={description}>
  <article class="project-post-container">
    <div class="prose-card surface-elevated">
      <div class="project-kicker">Case Study</div>
      <div class="project-content">
        <Content />
      </div>
      <div class="back-navigation">
        <a href="/projects" class="back-link">&larr; Back to all projects</a>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .project-post-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .prose-card {
    background: linear-gradient(165deg, rgba(16, 185, 129, 0.14), rgba(16, 185, 129, 0.01)), var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .project-kicker {
    margin: 0 0 0.65rem 0;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent-projects);
  }

  /* Target markdown contents */
  .project-content :global(h1) {
    font-size: 2.25rem;
    line-height: 1.2;
    margin: 0 0 1rem 0;
    letter-spacing: -0.025em;
  }

  .project-content :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .project-content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .project-content :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }

  /* Navigation footer */
  .back-navigation {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-smooth);
  }

  .back-link:hover {
    color: var(--accent-projects);
  }

  @media (max-width: 768px) {
    .prose-card {
      padding: 1.75rem 1.25rem;
      border-radius: 8px;
    }
  }
</style>
