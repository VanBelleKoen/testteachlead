---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getProjectCards } from '../../lib/content';

const projects = await getProjectCards();
---

<SiteLayout title="Projects" description="Personal and professional projects by Koen Van Belle.">
  <div class="projects-container">
    <header class="page-header surface-elevated animate-rise-in">
      <div class="section-kicker">Delivery Portfolio</div>
      <h1 class="page-title">Projects</h1>
      <p class="page-subtitle">A collection of systems, applications, and integrations I have built or tested.</p>
    </header>

    <div class="projects-grid">
      {projects.map(project => {
        return (
          <article class="project-card motion-lift">
            <div class="card-body">
              <div class="card-tags">
                {project.tags.map(tag => (
                  <span class="tag-badge">{tag}</span>
                ))}
              </div>
              <h3 class="card-title">
                <a href={`/projects/${project.slug}`} class="card-link">
                  {project.title.split(' (')[0]}
                </a>
              </h3>
              {project.title.includes('(') && (
                <div class="card-org">{project.title.match(/\(([^)]+)\)/)?.[0]}</div>
              )}
              <p class="card-desc">{project.description}</p>
            </div>
            <div class="card-footer">
              <a href={`/projects/${project.slug}`} class="read-more-link">
                View project details <span class="arrow">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</SiteLayout>

<style>
  .projects-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2.2rem 1.4rem 1.8rem 1.4rem;
    text-align: center;
    margin-bottom: 2.2rem;
    box-shadow: var(--shadow-sm);
  }

  .section-kicker {
    margin: 0 0 0.55rem 0;
    font-size: 0.74rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent-projects);
    font-family: var(--font-mono);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Grid Layout */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.45rem;
  }

  .project-card {
    background: linear-gradient(160deg, rgba(16, 185, 129, 0.13), rgba(16, 185, 129, 0.01)), var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth), transform var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag-badge {
    font-size: 0.75rem;
    background: rgba(6, 10, 18, 0.54);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.18rem 0.52rem;
    border-radius: 999px;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    line-height: 1.35;
  }

  .card-link {
    color: var(--text-primary);
    transition: color var(--transition-smooth);
  }

  .card-link:hover {
    color: var(--accent-projects);
  }

  .card-org {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .read-more-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color var(--transition-smooth);
  }

  .project-card:hover .read-more-link {
    color: var(--accent-primary);
  }

  .arrow {
    transition: transform var(--transition-smooth);
  }

  .project-card:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
