---
import yaml from 'js-yaml';
import fs from 'fs';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Engagement {
  date: string;
  title: string;
  location: string;
  description: string;
}

const yamlFile: string = fs.readFileSync('src/content/speaking.yaml', 'utf8');
const yamlData = yaml.load(yamlFile) as { engagements: Engagement[] };

function getStartDate(dateVal: string | Date): Date {
  if (dateVal instanceof Date) return dateVal;
  const str = String(dateVal);
  if (str.includes(' - ')) {
    return new Date(str.split(' - ')[0].trim());
  }
  return new Date(str.trim());
}

const engagements: Engagement[] = yamlData.engagements.sort((a, b) => {
  return getStartDate(b.date).getTime() - getStartDate(a.date).getTime();
});
---

<SiteLayout title="Speaking Engagements" description="Upcoming and past speaking events by Koen Van Belle.">
  <div class="speaking-container">
    <header class="page-header">
      <h1 class="page-title">Speaking Engagements</h1>
      <p class="page-subtitle">Past and upcoming tech talks, panels, and presentations.</p>
    </header>

    <div class="timeline">
      {engagements.map((e: Engagement) => {
        let dateDisplay = '';
        if (typeof e.date === 'string' && e.date.includes(' - ')) {
          const parts = e.date.split(' - ').map(s => s.trim());
          if (parts.length === 2) {
            const start = new Date(parts[0]);
            const end = new Date(parts[1]);
            dateDisplay = `${start.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })} - ${end.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}`;
          } else {
            dateDisplay = new Date(e.date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
          }
        } else {
          dateDisplay = new Date(e.date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
        }
        return (
          <div class="timeline-item">
            <div class="timeline-badge">
              <span class="timeline-dot"></span>
            </div>
            <div class="timeline-content">
              <div class="engagement-meta">
                <span class="engagement-date">{dateDisplay}</span>
                <span class="engagement-location">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="location-icon">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  {e.location}
                </span>
              </div>
              <h3 class="engagement-title">{e.title}</h3>
              <p class="engagement-desc">{e.description}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</SiteLayout>

<style>
  .speaking-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 4.5px;
    width: 2px;
    background: var(--border-color);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-badge {
    position: absolute;
    left: -2rem;
    top: 0.5rem;
    width: 11px;
    height: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2px solid var(--accent-primary);
  }

  .timeline-content {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.75rem;
  }

  .engagement-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .engagement-date {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .engagement-location {
    color: var(--text-muted);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .location-icon {
    color: var(--text-muted);
  }

  .engagement-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .engagement-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .timeline {
      padding-left: 1.5rem;
    }
    
    .timeline::before {
      left: 3.5px;
    }

    .timeline-badge {
      left: -1.5rem;
    }

    .timeline-dot {
      width: 9px;
      height: 9px;
    }

    .timeline-content {
      padding: 1.25rem;
    }

    .engagement-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
