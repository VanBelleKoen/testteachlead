---
import SiteLayout from './SiteLayout.astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';

interface BlogPostProps {
  title: string;
  description: string;
  pubDate: string | Date;
  updatedDate?: string | Date;
  heroImage?: string | ImageMetadata;
}

const { title, description, pubDate, updatedDate } = Astro.props as BlogPostProps;

function toDate(val: string | Date | undefined): Date | undefined {
  if (!val) return undefined;
  return val instanceof Date ? val : new Date(val);
}

const pubDateObj = toDate(pubDate);
const updatedDateObj = toDate(updatedDate);

---

<SiteLayout title={title} description={description}>
  <article class="blogpost-single">
    <div class="prose">
      <div class="title">
        <div class="date">
          {pubDateObj instanceof Date && !isNaN(pubDateObj.getTime()) && <FormattedDate date={pubDateObj} />}
          {updatedDateObj instanceof Date && !isNaN(updatedDateObj.getTime()) && (
            <div class="last-updated-on">
              Last updated on <FormattedDate date={updatedDateObj} />
            </div>
          )}
        </div>
        <h1>{title}</h1>
        <hr />
      </div>
      <div>
        <slot />
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .blogpost-single {
    width: auto;
    margin: 0 auto;
    padding: 2rem 1rem;
    background: var(--bg-card);
    border-radius: 1.2rem;
    box-shadow: var(--box-shadow);
    box-sizing: border-box;
    border: 1px solid var(--border-color);
  }
  .prose ul,
  .prose ol {
    list-style: none;
    padding-left: 0;
    margin-left: 0;
  }
  .prose pre {
    max-width: 100%;
    width: 100%;
    overflow-x: auto !important;
    overflow-y: hidden;
    background: var(--bg-secondary);
    color: var(--text-primary);
    border-radius: 8px;
    padding: 1em;
    font-size: 0.95em;
    box-sizing: border-box;
    white-space: pre;
    word-break: normal;
    display: block;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border-color);
  }
  .prose code {
    word-break: normal;
    white-space: pre;
    font-family: 'Fira Mono', 'Menlo', 'Monaco', 'Consolas', monospace;
    font-size: 0.97em;
    background: none;
    padding: 0;
    border: none;
    display: inline;
  }
</style>
