---
import SiteLayout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface BlogPostProps {
  title: string;
  description: string;
  pubDate: string | Date;
  updatedDate?: string | Date;
  heroImage?: string;
  tags?: Array<{ label: string; slug: string }>;
  category?: { label: string; slug: string };
}

const { title, description, pubDate, updatedDate, tags = [], category } = Astro.props as BlogPostProps;

function toDate(val: string | Date | undefined): Date | undefined {
  if (!val) return undefined;
  return val instanceof Date ? val : new Date(val);
}

const pubDateObj = toDate(pubDate);
const updatedDateObj = toDate(updatedDate);
---

<SiteLayout title={title} description={description}>
  <article class="blog-post-container">
    <div class="prose-card">
      <header class="post-header">
        <div class="post-kicker">Editorial</div>
        <div class="post-meta">
          {pubDateObj instanceof Date && !isNaN(pubDateObj.getTime()) && (
            <span class="pub-date"><FormattedDate date={pubDateObj} /></span>
          )}
          {updatedDateObj instanceof Date && !isNaN(updatedDateObj.getTime()) && (
            <span class="updated-date">
              (Updated <FormattedDate date={updatedDateObj} />)
            </span>
          )}
        </div>
        {(category || tags.length > 0) && (
          <div class="taxonomy-row">
            {category && (
              <a href={`/blog/categories/${category.slug}/`} class="category-chip">{category.label}</a>
            )}
            {tags.slice(0, 4).map((tag) => (
              <a href={`/blog/tags/${tag.slug}/`} class="tag-chip">{tag.label}</a>
            ))}
          </div>
        )}
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <hr class="header-divider" />
      </header>
      <div class="post-content">
        <slot />
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .blog-post-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .prose-card {
    background: linear-gradient(160deg, rgba(34, 211, 238, 0.1), rgba(34, 211, 238, 0.02)), var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--accent-blog);
    margin-bottom: 0.5rem;
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.5rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .taxonomy-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.95rem;
  }

  .category-chip,
  .tag-chip {
    border-radius: 999px;
    border: 1px solid var(--border-color);
    padding: 0.16rem 0.62rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .category-chip {
    border-color: rgba(34, 211, 238, 0.45);
    background: rgba(34, 211, 238, 0.12);
    color: var(--accent-blog);
  }

  .tag-chip:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .post-title {
    font-size: 2.25rem;
    line-height: 1.2;
    margin: 0.5rem 0 1rem 0;
    letter-spacing: -0.025em;
  }

  .post-description {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 58ch;
  }

  .header-divider {
    border: none;
    height: 1px;
    background: var(--border-color);
    margin: 1.5rem 0;
  }

  .post-content :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .post-content :global(h3) {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }

  .post-content :global(pre) {
    margin: 1.75rem 0;
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary) !important;
    overflow-x: auto;
  }

  .post-content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
  }

  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  @media (max-width: 768px) {
    .prose-card {
      padding: 1.75rem 1.25rem;
      border-radius: 8px;
    }

    .post-title {
      font-size: 1.75rem;
    }
  }
</style>
