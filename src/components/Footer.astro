---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<p class="copyright">&copy; {today.getFullYear()} Koen Van Belle. All rights reserved.</p>
		<div class="social-links">
			<a href="https://github.com/VanBelleKoen" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
			<a href="https://linkedin.com/in/vanbellekoen" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M1.5 0C.67 0 0 .67 0 1.5v13c0 .83.67 1.5 1.5 1.5h13c.83 0 1.5-.67 1.5-1.5v-13C16 .67 15.33 0 14.5 0h-13zM4.25 14H2V6h2.25v8zm-1.12-9.17c-.72 0-1.3-.58-1.3-1.3s.58-1.3 1.3-1.3c.72 0 1.3.58 1.3 1.3s-.58 1.3-1.3 1.3zm10.37 9.17h-2V9c0-.72-.01-1.65-1-1.65s-1 .78-1 .79v5h-2V6h2v1h-.03c.27-.51 1-.79 2-.79s2 .99 2 .99v6z"/>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg-primary);
		border-top: 1px solid var(--border-color);
		padding: 2.5rem 1.5rem;
		margin-top: auto;
		width: 100%;
	}

	.footer-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1000px;
		margin: 0 auto;
	}

	.copyright {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.social-links {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	.social-link {
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		transition: color var(--transition-smooth);
	}

	.social-link:hover {
		color: var(--accent-primary);
	}

	@media (max-width: 768px) {
		.footer-container {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>
